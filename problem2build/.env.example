# Firebase Console > Project settings > General > Your apps > Web app config
# Public production origin used for canonical links, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://tryitch.online
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional App Check site key. Public Firestore writes are validated by Firestore Security Rules.
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Optional
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
